#!/bin/sh
# Pre-commit hook: run the repo checks on the staged changes.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
for py in python3 python "py -3"; do
  # Probe each one: Windows ships a python3 stub that only opens the Store.
  # $py is unquoted on purpose: "py -3" is two words.
  if $py -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    exec $py tools/checks.py --staged
  fi
done
echo "pre-commit: no Python 3.10+ found (tried python3, python, py -3); commit blocked." >&2
exit 1
